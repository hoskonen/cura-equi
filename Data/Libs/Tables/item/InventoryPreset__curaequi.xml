	<!-- ========================= -->
	<!-- Cura Equi: Horse Trader per-location presets (Mode=AmountCount) -->
	<!-- ========================= -->

	<!-- Cura Equi: Horse Food Preset: Some (small, rare pool) -->
	<InventoryPreset Name="curaequi_horsefood" Mode="AmountCount" ModeValue="1" ModeValueVariation="1">
		<PresetItem Name="curaequi_hay_bundle_sm" Amount="1" AmountVariation="1" Weight="2"/>  
		<PresetItem Name="curaequi_hay_bundle_lg" Amount="1" Weight="1"/> 
		<PresetItem Name="curaequi_oat_sack" Amount="1" AmountVariation="1" Weight="1"/>  
	</InventoryPreset>

	<!-- Cura Equi: Horse Food Preset: Grocer (produce-forward, common) -->
	<InventoryPreset Name="curaequi_horsefood_grocer" Mode="AmountCount" ModeValue="2" ModeValueVariation="1">
		<PresetItem Name="curaequi_apple_sack" Amount="1" AmountVariation="1" Weight="6"/>  
		<PresetItem Name="curaequi_carrot_bundle" Amount="2" AmountVariation="3" Weight="5"/>  
		<PresetItem Name="curaequi_pear_sack" Amount="1" AmountVariation="1" Weight="2"/>  
	</InventoryPreset>

